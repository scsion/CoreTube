<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.coretube" name="CoreTube Repository" version="1.0.0" provider-name="scsion">
    <!-- Served from the "repo" branch of github.com/scsion/CoreTube, which
         tools/build_repo.py writes. -->
    <extension point="xbmc.addon.repository" name="CoreTube Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/scsion/CoreTube/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/scsion/CoreTube/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/scsion/CoreTube/repo/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Updates for CoreTube</summary>
        <description lang="en_GB">Install CoreTube from this repository and Kodi keeps it up to date automatically.</description>
        <disclaimer lang="en_GB">Not affiliated with or endorsed by Google, YouTube or the CoreELEC team.</disclaimer>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <website>https://github.com/scsion/CoreTube</website>
        <source>https://github.com/scsion/CoreTube</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
