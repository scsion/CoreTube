msgstr ""

msgctxt "#39062"
msgid "[COLOR white]Covers the screen with the CoreTube backdrop the moment CoreTube starts, so Kodi's Videos or Programs screen doesn't flash up while the TV interface loads.[/COLOR]"
msgstr ""

msgctxt "#39063"
msgid "Leave to the Home screen"
msgstr ""

msgctxt "#39064"
msgid "[COLOR white]When CoreTube was opened from a list such as Video add-ons or Program add-ons, leaving it goes to Kodi's Home screen instead of back to that list. Opening it from the Home screen (a menu entry or Favourites) is not affected.[/COLOR]"
msgstr ""

